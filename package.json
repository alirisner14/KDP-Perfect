{
  "name": "kdp-perfect",
  "productName": "KDP Perfect",
  "version": "0.2.1",
  "description": "Cover templates, preflight checks and 3D mockups for Amazon KDP paperbacks, hardcovers and Kindle eBooks.",
  "private": true,
  "license": "MIT",
  "author": "KDP Perfect contributors",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "predev:desktop": "node scripts/ensure-electron.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "prestart": "node scripts/ensure-electron.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke-desktop.mjs",
    "presmoke": "node scripts/ensure-electron.mjs",
    "icon": "node scripts/make-icon.mjs",
    "predist": "node scripts/ensure-electron.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win -c.electronDist=node_modules/electron/dist",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.kdpperfect.app",
    "productName": "KDP Perfect",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontherisedigital/KDP-Perfect.git"
  },
  "keywords": [
    "kdp",
    "amazon-kdp",
    "book-cover",
    "cover-template",
    "hardcover",
    "kindle",
    "preflight",
    "3d-mockup",
    "self-publishing",
    "paperback",
    "electron"
  ]
}
